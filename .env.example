# Copy to .env.local and adjust.

# MySQL (XAMPP defaults). The database and tables are created automatically.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tiles
# …or a single connection string instead of the above:
# DATABASE_URL=mysql://user:pass@host:3306/tiles

# First admin account (only used when the users table is empty)
ADMIN_EMAIL=admin@tilora.com
ADMIN_PASSWORD=admin123

# Signs the admin session cookie — use a long random string in production
SESSION_SECRET=replace-with-a-long-random-string
